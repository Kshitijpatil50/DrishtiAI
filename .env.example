# ==============================================================================
# Drishti AI — Environment Variables Template
# ==============================================================================
# Local development:
#   Copy this file to `.env` (already gitignored) and fill in your own API keys.
#   Never commit `.env` or real API keys to GitHub.
#
# Vercel deployment:
#   Add these variables under:
#   Vercel Dashboard -> Your Project -> Settings -> Environment Variables
#   Select Production, Preview, and Development, then redeploy.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini API Key (Required)
# ------------------------------------------------------------------------------
# Used server-side by `/api/gemini/scene` and `/api/gemini/question` for
# real-time camera scene narration, hazard detection, and visual Q&A.
# Accepted server variable names: GEMINI_API_KEY (recommended) or VITE_GEMINI_API_KEY
# Where to get it: https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 2. Gnani AI API Key (Recommended — required for Shivani voice & Prisma STT)
# ------------------------------------------------------------------------------
# Used server-side by `/api/gnani/tts` (Gnani Timbre v3.0 — Shivani voice) and
# `/api/gnani/stt` (Gnani Prisma v3.0 Hindi/English speech-to-text).
# Set this in your server environment / Vercel Environment Variables so users
# never need to enter any key manually. Falls back to browser speech if unset.
# Accepted server variable names: GNANI_API_KEY (recommended), VITE_GNANI_API_KEY, or GNANI_KEY
# Sent via HTTP header: X-API-Key-ID (API base: https://api.vachana.ai)
GNANI_API_KEY="YOUR_GNANI_API_KEY"

# ------------------------------------------------------------------------------
# 3. Runtime & Server Options (Optional)
# ------------------------------------------------------------------------------
# Host URL injected automatically by AI Studio in preview/hosted environments.
APP_URL="http://localhost:3000"

# Express server port in production (defaults to 3000).
# PORT="3000"

# Set to "production" when running `npm start` outside Vercel.
# NODE_ENV="development"

# Set to "true" to disable Vite HMR watcher (used in headless/container dev).
# DISABLE_HMR="false"

